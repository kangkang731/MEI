<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mei.mapper.MeiMessageMapper">
    
    <resultMap type="MeiMessage" id="MeiMessageResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="content"    column="content"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectMeiMessageVo">
        select id, user_id, content, create_time from mei_message
    </sql>

    <select id="selectMeiMessageList" parameterType="MeiMessage" resultMap="MeiMessageResult">
        <include refid="selectMeiMessageVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
        </where>
    </select>
    
    <select id="selectMeiMessageById" parameterType="Long" resultMap="MeiMessageResult">
        <include refid="selectMeiMessageVo"/>
        where id = #{id}
    </select>

    <insert id="insertMeiMessage" parameterType="MeiMessage" useGeneratedKeys="true" keyProperty="id">
        insert into mei_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateMeiMessage" parameterType="MeiMessage">
        update mei_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMeiMessageById" parameterType="Long">
        delete from mei_message where id = #{id}
    </delete>

    <delete id="deleteMeiMessageByIds" parameterType="String">
        delete from mei_message where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>