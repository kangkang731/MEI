<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mei.mapper.MeiExpertMapper">
    
    <resultMap type="MeiExpert" id="MeiExpertResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="name"    column="name"    />
        <result property="major"    column="major"    />
        <result property="intro"    column="intro"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectMeiExpertVo">
        select id, user_id, name, major, intro, status from mei_expert
    </sql>

    <select id="selectMeiExpertList" parameterType="MeiExpert" resultMap="MeiExpertResult">
        <include refid="selectMeiExpertVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="major != null  and major != ''"> and major = #{major}</if>
            <if test="intro != null  and intro != ''"> and intro = #{intro}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectMeiExpertById" parameterType="Long" resultMap="MeiExpertResult">
        <include refid="selectMeiExpertVo"/>
        where id = #{id}
    </select>

    <insert id="insertMeiExpert" parameterType="MeiExpert" useGeneratedKeys="true" keyProperty="id">
        insert into mei_expert
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="major != null and major != ''">major,</if>
            <if test="intro != null">intro,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="major != null and major != ''">#{major},</if>
            <if test="intro != null">#{intro},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateMeiExpert" parameterType="MeiExpert">
        update mei_expert
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="major != null and major != ''">major = #{major},</if>
            <if test="intro != null">intro = #{intro},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMeiExpertById" parameterType="Long">
        delete from mei_expert where id = #{id}
    </delete>

    <delete id="deleteMeiExpertByIds">
        delete from mei_expert where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>