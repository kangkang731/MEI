<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mei.mapper.MeiFinanceMapper">
    
    <resultMap type="MeiFinance" id="MeiFinanceResult">
        <result property="id"    column="id"    />
        <result property="companyId"    column="company_id"    />
        <result property="money"    column="money"    />
        <result property="reason"    column="reason"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectMeiFinanceVo">
        select id, company_id, money, reason, status, create_time from mei_finance
    </sql>

    <select id="selectMeiFinanceList" parameterType="MeiFinance" resultMap="MeiFinanceResult">
        <include refid="selectMeiFinanceVo"/>
        <where>  
            <if test="companyId != null "> and company_id = #{companyId}</if>
            <if test="money != null "> and money = #{money}</if>
            <if test="reason != null  and reason != ''"> and reason = #{reason}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectMeiFinanceById" parameterType="Long" resultMap="MeiFinanceResult">
        <include refid="selectMeiFinanceVo"/>
        where id = #{id}
    </select>

    <insert id="insertMeiFinance" parameterType="MeiFinance" useGeneratedKeys="true" keyProperty="id">
        insert into mei_finance
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="companyId != null">company_id,</if>
            <if test="money != null">money,</if>
            <if test="reason != null">reason,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="companyId != null">#{companyId},</if>
            <if test="money != null">#{money},</if>
            <if test="reason != null">#{reason},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateMeiFinance" parameterType="MeiFinance">
        update mei_finance
        <trim prefix="SET" suffixOverrides=",">
            <if test="companyId != null">company_id = #{companyId},</if>
            <if test="money != null">money = #{money},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMeiFinanceById" parameterType="Long">
        delete from mei_finance where id = #{id}
    </delete>

    <delete id="deleteMeiFinanceByIds">
        delete from mei_finance where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>